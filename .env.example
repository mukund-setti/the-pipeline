# Copy to .env for local dev, and set the same variables in your Vercel project
# (Project Settings > Environment Variables). See docs/PORTAL.md.

# Supabase project: Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Gated Discord invite. Server-only secret, never exposed to the client bundle.
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Server-only Supabase key (Project Settings > API > service_role). The
# opportunity scanner writes rows with it; it bypasses RLS, keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enables the Hacker News "Who is hiring" AI extraction in the
# opportunity scanner. Without it that source is skipped.
ANTHROPIC_API_KEY=sk-ant-your-key

# Protects /api/opportunities-scan. Vercel Cron sends it as a Bearer token
# automatically; manual runs pass it in the x-scan-secret header.
CRON_SECRET=generate-a-long-random-string

# Optional: the daily scan announces new drops to this Discord webhook.
DISCORD_DROPS_WEBHOOK=https://discord.com/api/webhooks/your-webhook
