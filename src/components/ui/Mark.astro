---
/**
 * The Pipeline logo: a sprout whose roots are circuit traces ending in node
 * dots. The sprout is the fellow growing; the routed roots are the pipeline
 * carrying access to them. Drawn in brand greens so it reads on both the
 * cream header and the deep fern footer. Brand asset, so literal colors are
 * sanctioned.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
---
<span
  class:list={['inline-grid flex-none place-items-center', className]}
  style={`width:${size}px;height:${Math.round(size * 1.08)}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 120 130" class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
    <!-- Circuit-trace roots -->
    <g fill="none" stroke="#6FCF6A" stroke-width="7" stroke-linecap="round">
      <path d="M60 78 H106"></path>
      <path d="M60 78 V96 L46 112"></path>
      <path d="M60 96 L76 106"></path>
      <path d="M60 78 L38 90"></path>
    </g>
    <g fill="#6FCF6A">
      <circle cx="110" cy="78" r="5"></circle>
      <circle cx="43" cy="115" r="5"></circle>
      <circle cx="79" cy="108" r="5"></circle>
      <circle cx="34" cy="92" r="5"></circle>
    </g>
    <!-- Stem and leaves -->
    <path d="M60 40 V78" fill="none" stroke="#256B3C" stroke-width="11" stroke-linecap="round"></path>
    <path d="M60 40 C57 24 48 10 30 5 C32 23 44 36 60 40 Z" fill="#2F7D47"></path>
    <path d="M62 46 C70 33 85 25 103 27 C96 42 80 50 62 46 Z" fill="#6FCF6A"></path>
  </svg>
</span>
