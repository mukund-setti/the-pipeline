---
/**
 * The Pipeline logo: a sprout rising out of an open conduit. The cup is the
 * pipeline (access, handed over); the sprout is the fellow growing up through
 * it. Sunlight gold on a deep canopy tile, so it stays legible on both the
 * dark header and footer and any light surface. Brand asset, so literal
 * colors are sanctioned.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
---
<span
  class:list={['inline-grid flex-none place-items-center overflow-hidden bg-canopy-2 ring-1 ring-white/10', className]}
  style={`width:${size}px;height:${size}px;border-radius:30%`}
  aria-hidden="true"
>
  <svg viewBox="0 0 100 100" class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
    <g fill="none" stroke="#D9A84C" stroke-width="7" stroke-linecap="round">
      <!-- The open conduit -->
      <path d="M34 62 a16 16 0 0 0 32 0"></path>
      <!-- The stem -->
      <path d="M50 70 V42"></path>
    </g>
    <!-- Leaves: lower-left, upper-right -->
    <path d="M50 52 C48 41 42 33 29 30 C31 42 39 50 50 52 Z" fill="#D9A84C"></path>
    <path d="M50 43 C52 31 59 23 71 20 C69 33 61 41 50 43 Z" fill="#E8BE6A"></path>
  </svg>
</span>
