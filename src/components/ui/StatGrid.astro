---
import Stat from './Stat.astro';
import { stats as defaultStats, type Stat as StatType } from '../../data/site';

interface Props {
  stats?: StatType[];
  class?: string;
}
const { stats = defaultStats, class: className = '' } = Astro.props;
// gap-px over a hairline backdrop draws soft dividers at any column count.
// Desktop column count follows the stat count (literal classes so Tailwind's
// JIT keeps them); medium and small breakpoints stay fixed.
const colsClass =
  ({ 3: 'grid-cols-3', 4: 'grid-cols-4', 5: 'grid-cols-5' } as const)[stats.length] ?? 'grid-cols-4';
---
<div
  class:list={[
    'grid gap-px overflow-hidden rounded-panel border border-line bg-line max-[860px]:grid-cols-2 max-[860px]:[&>*:last-child:nth-child(odd)]:col-span-2',
    colsClass,
    className,
  ]}
>
  {stats.map((s) => <Stat num={s.num} cap={s.cap} win={s.win} />)}
</div>
