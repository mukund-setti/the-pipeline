---
/**
 * The signature rail: a warm dotted path flowing toward a glowing gold
 * arrival sun on the right. Decorative, so aria-hidden.
 */
interface Props {
  notes?: boolean;
  tone?: 'light' | 'dark';
  class?: string;
}
const { notes = false, tone = 'light', class: className = '' } = Astro.props;
---
<div class:list={['relative', className]} aria-hidden="true">
  <div
    class:list={[
      'relative h-2 overflow-hidden rounded-pill',
      tone === 'dark' ? 'bg-white/5' : 'bg-brand-soft/80',
    ]}
  >
    <div
      class:list={[
        'animate-flow absolute inset-y-0 -left-[34px] right-0',
        tone === 'dark' ? 'conduit-current' : 'conduit-current-light',
      ]}
    ></div>
  </div>
  <div class="conduit-tip animate-glow absolute right-0 top-1 h-3.5 w-3.5 -translate-y-1/2"></div>
  {
    notes && (
      <div
        class:list={[
          'label mt-4 flex justify-between text-[0.64rem]',
          tone === 'dark' ? 'text-ondark-soft' : 'text-ink-soft',
        ]}
      >
        <span>Talent in</span>
        <span>Offers out</span>
      </div>
    )
  }
</div>
