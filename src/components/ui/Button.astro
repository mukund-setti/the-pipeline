---
/**
 * Warm pill button. primary = sunlit gold fill / ghost = soft moss border /
 * ghostDark = on canopy. Renders an <a> when `href` is set, else a <button>.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'ghostDark';
  arrow?: boolean;
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  'aria-current'?: 'page' | undefined;
}

const {
  href,
  variant = 'primary',
  arrow = false,
  external = false,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'lift-sm group inline-flex items-center justify-center gap-2.5 rounded-pill border px-7 py-3.5 font-sans text-base font-semibold';
const variants = {
  primary: 'border-transparent bg-gold-bright text-canopy hover:bg-gold-pale',
  ghost: 'border-line-strong bg-transparent text-ink hover:border-ink hover:bg-brand-soft/60',
  ghostDark: 'border-white/25 bg-transparent text-ondark hover:border-gold/60 hover:text-gold-pale',
};
const cls = [base, variants[variant], className].join(' ');
const extra = external ? { target: '_blank', rel: 'noopener' } : {};
const Tag = href ? 'a' : 'button';
---
<Tag class={cls} {...(href ? { href } : { type })} {...extra} {...rest}>
  <slot />
  {arrow && <span class="nudge" aria-hidden="true">→</span>}
</Tag>
