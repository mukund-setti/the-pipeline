---
/**
 * University verification gate (progressive enhancement, no framework).
 * The "choose" form is static HTML, so it paints instantly and works as far as
 * showing the options with zero JS. A small script wires up Supabase auth
 * (loaded lazily, only on interaction or an OAuth return), then swaps between
 * the prebuilt state sections. The Discord invite is fetched from the gated
 * server endpoint and is never in this bundle.
 */
interface Props {
  formUrl?: string;
}
const { formUrl } = Astro.props;

const PRIMARY =
  'inline-flex w-full items-center justify-center gap-2.5 border-2 border-transparent bg-brand px-6 py-3.5 font-sans text-base font-semibold text-white transition-colors hover:bg-brand-deep';
const GHOST =
  'inline-flex w-full items-center justify-center gap-2.5 border-2 border-line bg-transparent px-6 py-3.5 font-sans text-base font-semibold text-ink transition-colors hover:bg-brand-soft';
const INPUT =
  'w-full border-2 border-line bg-bg px-4 py-3 font-sans text-base text-ink outline-none transition-colors placeholder:text-ink-soft/60 focus:border-ink';
const LABEL = 'mb-1.5 block font-mono text-[0.7rem] uppercase tracking-[0.1em] text-ink-soft';
const SUBLINK = 'font-mono text-[0.72rem] uppercase tracking-[0.08em]';
---
<div data-vg-root class="max-w-[440px]">
  {/* choose */}
  <section data-vg="choose">
    <form data-vg-email-form novalidate>
      <label class={LABEL} for="vg-email">University email</label>
      <input id="vg-email" class={INPUT} type="email" inputmode="email" autocomplete="email" required placeholder="you@uci.edu" />
      <button type="submit" class={`${PRIMARY} mt-3`}>Email me a sign-in link</button>
    </form>

    <p class="mt-4 font-mono text-[0.72rem] leading-relaxed text-ink-soft">
      Open to UC students for now. We only ever email your sign-in link.
    </p>
  </section>

  {/* linkSent */}
  <section data-vg="codeSent" hidden>
    <div class="mb-2 font-display text-[1.4rem] font-extrabold text-ink">Check your email.</div>
    <p class="mb-5 text-ink-soft">
      We sent a sign-in link to <span class="font-semibold text-ink" data-vg-email></span>. Open it
      from your inbox to verify and get in. It can take a minute; check spam too.
    </p>
    <div class="flex flex-wrap gap-x-5 gap-y-1">
      <button type="button" class={`${SUBLINK} text-ink underline-offset-4 hover:underline`} data-vg-resend>Resend link</button>
      <button type="button" class={`${SUBLINK} text-ink-soft hover:text-ink`} data-vg-reset>Use a different email</button>
    </div>
  </section>

  {/* busy */}
  <section data-vg="busy" hidden>
    <div class="flex items-center gap-3 py-2 text-ink-soft" aria-live="polite">
      <span class="h-4 w-4 animate-spin rounded-full border-2 border-ink/20 border-t-signal"></span>
      <span class="font-mono text-[0.8rem] uppercase tracking-[0.1em]" data-vg-busy>Working</span>
    </div>
  </section>

  {/* verified */}
  <section data-vg="verified" hidden>
    <div class="mb-2 flex items-center gap-2.5">
      <span class="flex h-7 w-7 flex-none items-center justify-center bg-signal">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 13l4 4L19 7"></path>
        </svg>
      </span>
      <span class="font-display text-[1.4rem] font-extrabold text-ink">You're in. Welcome to The Pipeline.</span>
    </div>
    <p class="mb-5 text-ink-soft">
      Verified as <span class="font-semibold text-ink" data-vg-email></span>. The job drops, office
      hours, and the community are through here.
    </p>
    <a class={PRIMARY} data-vg-invite href="#" target="_blank" rel="noopener" hidden>
      Open the Discord <span aria-hidden="true">&rarr;</span>
    </a>
    {formUrl && (
      <a class={`${GHOST} mt-3`} href={formUrl} target="_blank" rel="noopener">Fill the interest form</a>
    )}
    <button type="button" class={`${SUBLINK} mt-4 block text-ink-soft hover:text-ink`} data-vg-reset>
      Not you? Sign out
    </button>
  </section>

  {/* blocked */}
  <section data-vg="blocked" hidden>
    <div class="mb-2 font-display text-[1.4rem] font-extrabold text-ink">
      Almost. We're not at your campus yet.
    </div>
    <p class="mb-5 text-ink-soft">
      The Pipeline is open to UC students right now. More campuses are coming. If you want yours
      next, tell us you stopped by.
    </p>
    {formUrl && (
      <a class={PRIMARY} href={formUrl} target="_blank" rel="noopener">
        Leave your email <span aria-hidden="true">&rarr;</span>
      </a>
    )}
    <button type="button" class={`${SUBLINK} mt-4 block text-ink-soft hover:text-ink`} data-vg-reset>
      Use a different email
    </button>
  </section>

  <p data-vg-note class="mt-3 font-mono text-[0.75rem] text-ink-soft" aria-live="polite" hidden></p>
</div>

<script>
  import { partnerForEmail } from '../../lib/partners';

  const root = document.querySelector<HTMLElement>('[data-vg-root]');
  if (root) init(root);

  function init(root: HTMLElement) {
    // undefined = not loaded yet, null = configured-but-absent (env missing)
    let supa: any;
    let email = '';
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s);
    const sections = root.querySelectorAll<HTMLElement>('[data-vg]');
    const noteEl = $<HTMLElement>('[data-vg-note]');
    const inviteEl = $<HTMLAnchorElement>('[data-vg-invite]');

    const show = (state: string) => {
      sections.forEach((s) => (s.hidden = s.getAttribute('data-vg') !== state));
      setNote('');
    };
    const setNote = (msg: string) => {
      if (!noteEl) return;
      noteEl.textContent = msg;
      noteEl.hidden = !msg;
    };
    const setEmail = (e: string) =>
      root.querySelectorAll('[data-vg-email]').forEach((el) => (el.textContent = e));
    const setBusy = (label: string) => {
      const b = $<HTMLElement>('[data-vg-busy]');
      if (b) b.textContent = label;
      show('busy');
    };
    const notLive = () => setNote('Verification is not live yet. Check back shortly.');

    async function ensureSupa() {
      if (supa !== undefined) return supa;
      const { getSupabase } = await import('../../lib/supabase');
      supa = getSupabase();
      return supa;
    }

    async function evaluate(client: any, userEmail: string) {
      email = userEmail;
      setEmail(userEmail);
      if (!partnerForEmail(userEmail).ok) return show('blocked');
      setBusy('Unlocking the Discord');
      try {
        const { data } = await client.auth.getSession();
        const res = await fetch('/api/discord-invite', {
          method: 'POST',
          headers: { Authorization: `Bearer ${data.session?.access_token}` },
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.invite) {
          if (inviteEl) {
            inviteEl.href = body.invite;
            inviteEl.hidden = false;
          }
          show('verified');
        } else if (res.status === 403) {
          show('blocked');
        } else {
          if (inviteEl) inviteEl.hidden = true;
          show('verified');
          setNote('We could not load the invite just now. Refresh and try again.');
        }
      } catch {
        if (inviteEl) inviteEl.hidden = true;
        show('verified');
        setNote('Network hiccup loading the invite. Refresh and try again.');
      }
    }

    $('[data-vg-email-form]')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      email = ($<HTMLInputElement>('#vg-email')?.value || '').trim();
      if (!partnerForEmail(email).ok) {
        setEmail(email);
        return show('blocked');
      }
      const client = await ensureSupa();
      if (!client) return notLive();
      setBusy('Sending your link');
      const { error } = await client.auth.signInWithOtp({
        email,
        options: { shouldCreateUser: true, emailRedirectTo: `${location.origin}/join` },
      });
      if (error) {
        show('choose');
        setNote(error.message || 'Could not send the link. Try again.');
      } else {
        setEmail(email);
        show('codeSent');
      }
    });

    $('[data-vg-resend]')?.addEventListener('click', async () => {
      const client = await ensureSupa();
      if (!client) return notLive();
      setNote('Sending a new link...');
      await client.auth.signInWithOtp({
        email,
        options: { shouldCreateUser: true, emailRedirectTo: `${location.origin}/join` },
      });
      setNote('New link sent.');
    });

    root.querySelectorAll('[data-vg-reset]').forEach((b) =>
      b.addEventListener('click', async () => {
        const client = await ensureSupa();
        if (client) await client.auth.signOut();
        email = '';
        const ei = $<HTMLInputElement>('#vg-email');
        if (ei) ei.value = '';
        show('choose');
      })
    );

    // Dev-only state preview: /join?gate=verified|blocked|codeSent
    if (import.meta.env.DEV) {
      const g = new URLSearchParams(location.search).get('gate');
      if (g === 'verified') {
        setEmail('student@uci.edu');
        if (inviteEl) {
          inviteEl.href = 'https://discord.gg/your-server';
          inviteEl.hidden = false;
        }
        show('verified');
        return;
      }
      if (g === 'blocked') {
        setEmail('student@stanford.edu');
        show('blocked');
        return;
      }
      if (g === 'codeSent') {
        setEmail('student@uci.edu');
        show('codeSent');
        return;
      }
    }

    // Restore an existing session or finish an OAuth return. Only spin up
    // Supabase when there is plausibly a session, so a fresh visit stays light.
    const looksLikeReturn =
      location.hash.includes('access_token') ||
      location.search.includes('code=') ||
      Object.keys(localStorage).some((k) => k.startsWith('sb-'));
    if (looksLikeReturn) {
      (async () => {
        const client = await ensureSupa();
        if (!client) return;
        const { data } = await client.auth.getSession();
        if (data.session?.user?.email) await evaluate(client, data.session.user.email);
        client.auth.onAuthStateChange((_event: string, session: any) => {
          if (session?.user?.email) evaluate(client, session.user.email);
        });
      })();
    }
  }
</script>
