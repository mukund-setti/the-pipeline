---
interface Props {
  /** brand = light bg / onDark = canopy bg / deep = on tint callout. */
  tone?: 'brand' | 'onDark' | 'deep';
  as?: string;
  class?: string;
}
const { tone = 'brand', as = 'span', class: className = '' } = Astro.props;
const tones: Record<NonNullable<Props['tone']>, string> = {
  brand: 'text-ink-soft',
  onDark: 'text-ondark-soft',
  deep: 'text-ink',
};
const ticks: Record<NonNullable<Props['tone']>, string> = {
  brand: 'bg-gold-deep',
  onDark: 'bg-gold',
  deep: 'bg-gold-deep',
};
const Tag = as as any;
---
<Tag
  class:list={['label inline-flex items-center gap-2.5', tones[tone], className]}
>
  <span aria-hidden="true" class:list={['h-1.5 w-1.5 flex-none rounded-full', ticks[tone]]}></span>
  <slot />
</Tag>
