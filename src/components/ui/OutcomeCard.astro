---
interface Props {
  org: string;
  role?: string;
  /** Faint brand monogram backdrop. */
  mark?: string;
  /** Optional official logo image path; overrides the monogram. */
  logo?: string;
  /** CTA variant: a canopy card that closes the board. */
  cta?: boolean;
  href?: string;
  ctaLabel?: string;
}
const { org, role, mark, logo, cta = false, href, ctaLabel } = Astro.props;
---
{
  cta ? (
    <a
      href={href}
      class="lift group on-ink relative flex flex-col justify-between overflow-hidden rounded-card border border-line-dark bg-canopy p-6 text-ondark"
    >
      <div aria-hidden="true" class="light-shaft-soft" />
      <div class="relative">
        <span class="label text-[0.6rem] text-ondark-soft">next up</span>
        <h3 class="mt-4 font-display text-h3-lg font-semibold leading-tight text-ondark">{org}</h3>
      </div>
      <span class="label relative mt-6 inline-flex items-center gap-2 text-[0.7rem] text-gold">
        {ctaLabel} <span class="nudge" aria-hidden="true">→</span>
      </span>
    </a>
  ) : (
    <article class="lift group flex items-center gap-4 rounded-card border border-line bg-surface p-6">
      <div class="min-w-0 flex-1">
        <span class="label text-[0.6rem] text-signal">landed</span>
        <h3 class="mt-3 font-display text-h3-lg font-semibold leading-tight text-ink">{org}</h3>
        {role && <p class="label mt-1.5 text-[0.66rem] text-ink-soft">{role}</p>}
      </div>
      <div class="flex w-[38%] flex-none items-center justify-end">
        {
          logo ? (
            <img
              src={logo}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="animate-logoFade max-h-12 w-full select-none object-contain object-right"
            />
          ) : (
            mark && (
              <span
                aria-hidden="true"
                class="select-none font-display text-[3.25rem] font-semibold leading-none tracking-tight text-ink/20"
              >
                {mark}
              </span>
            )
          )
        }
      </div>
    </article>
  )
}
