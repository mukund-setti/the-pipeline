---
interface Props {
  org: string;
  role?: string;
  /** Faint brand monogram backdrop. */
  mark?: string;
  /** Optional official logo image path; overrides the monogram. */
  logo?: string;
  /** CTA variant: an ink card that closes the board. */
  cta?: boolean;
  href?: string;
  ctaLabel?: string;
}
const { org, role, mark, logo, cta = false, href, ctaLabel } = Astro.props;
---
{
  cta ? (
    <a
      href={href}
      class="lift group flex flex-col justify-between border-2 border-line-dark bg-ink p-6 text-ondark on-ink"
    >
      <div>
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-ondark-soft">
          next up
        </span>
        <h3 class="mt-4 font-display text-h3-lg font-semibold leading-tight text-white">{org}</h3>
      </div>
      <span class="mt-6 inline-flex items-center gap-2 font-mono text-[0.74rem] uppercase tracking-[0.08em] text-ondark-link">
        {ctaLabel} <span class="nudge" aria-hidden="true">→</span>
      </span>
    </a>
  ) : (
    <article class="lift group flex items-center gap-4 border-2 border-line bg-surface p-6">
      <div class="min-w-0 flex-1">
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-ink-soft">landed</span>
        <h3 class="mt-3 font-display text-h3-lg font-semibold leading-tight text-ink">{org}</h3>
        {role && (
          <p class="mt-1.5 font-mono text-[0.72rem] uppercase tracking-wider text-ink-soft">
            {role}
          </p>
        )}
      </div>
      <div class="flex w-[38%] flex-none items-center justify-end">
        {
          logo ? (
            <img
              src={logo}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="animate-logoFade max-h-12 w-full select-none object-contain object-right"
            />
          ) : (
            mark && (
              <span
                aria-hidden="true"
                class="select-none font-display text-[3.25rem] font-bold leading-none tracking-tight text-ink/25"
              >
                {mark}
              </span>
            )
          )
        }
      </div>
    </article>
  )
}
