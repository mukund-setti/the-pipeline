---
/** Line icons for the feature grid. Stroke uses currentColor. */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'h-full w-full' } = Astro.props;

const paths: Record<string, string> = {
  feed: '<path d="M3 7h18M3 12h18M3 17h12"/><circle cx="20" cy="17" r="1.6" fill="currentColor" stroke="none"/>',
  resume: '<path d="M7 4h7l4 4v12H7z"/><path d="M14 4v4h4"/><path d="M9.5 13l1.7 1.7L15 11"/>',
  mock: '<path d="M4 5h16v10H8l-4 4z"/><path d="M8 9h8M8 12h5"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>',
  strategy: '<path d="M3 17l5-5 4 3 6-7"/><path d="M14 8h4v4"/>',
  people:
    '<circle cx="8" cy="9" r="2.6"/><circle cx="16" cy="9" r="2.6"/><path d="M3.5 18c.6-2.6 2.4-4 4.5-4s3.9 1.4 4.5 4"/><path d="M14 14.2c1.8.1 3.4 1.5 4 3.8"/>',
};
const inner = paths[name] ?? '';
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
></svg>
