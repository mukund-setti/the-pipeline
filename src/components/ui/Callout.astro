---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---
<div class="rounded-panel border border-line bg-brand-soft/70 px-[clamp(26px,4vw,44px)] py-10">
  <Eyebrow tone="deep">{eyebrow}</Eyebrow>
  <h2 class="mb-3 mt-4 font-display text-[clamp(1.7rem,3.4vw,2.4rem)] font-semibold tracking-tight text-ink">
    {title}
  </h2>
  <p class="m-0 max-w-[56ch] text-ink-soft [&_b]:font-semibold [&_b]:text-ink"><slot /></p>
</div>
