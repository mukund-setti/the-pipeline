---
import Mark from './ui/Mark.astro';
import { nav, navCta } from '../data/site';

const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return path === h;
};
---
<header
  class="on-ink sticky top-0 z-50 border-b border-board-line bg-board-bg/95 text-board-text backdrop-blur supports-[backdrop-filter]:bg-board-bg/90"
>
  <div class="wrap">
    <nav
      class="flex h-[68px] items-center justify-between gap-4 max-[620px]:h-auto max-[620px]:flex-wrap max-[620px]:py-3"
      aria-label="Primary"
    >
      <a
        href="/"
        class="inline-flex items-center gap-3 font-boardMono text-[15px] font-semibold tracking-[0.06em] text-board-text"
        aria-label="The Pipeline, home"
      >
        <Mark size={34} />
        THE PIPELINE
      </a>

      <div class="flex flex-wrap items-center gap-1 max-[620px]:w-full max-[620px]:justify-start">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'relative whitespace-nowrap px-3.5 py-2 font-boardMono text-[12px] uppercase tracking-[0.08em] transition-colors',
                isActive(item.href) ? 'text-board-text' : 'text-board-textMuted hover:text-board-text',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              {isActive(item.href) && (
                <span aria-hidden="true" class="absolute inset-x-3.5 bottom-0 h-0.5 bg-board-green" />
              )}
            </a>
          ))
        }
        <a
          href={navCta.href}
          class="ml-2 inline-flex h-9 items-center whitespace-nowrap bg-board-green px-5 font-boardSans text-[14px] font-semibold text-board-greenInk transition-colors hover:bg-board-text"
          aria-current={isActive(navCta.href) ? 'page' : undefined}
        >
          {navCta.label}
        </a>
      </div>
    </nav>
  </div>
</header>
