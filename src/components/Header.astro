---
import Mark from './ui/Mark.astro';
import { nav, navCta } from '../data/site';

const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return path === h;
};
---
<header
  class="on-ink sticky top-0 z-50 border-b border-line-dark bg-canopy/95 text-ondark backdrop-blur supports-[backdrop-filter]:bg-canopy/85"
>
  <div class="wrap">
    <nav
      class="flex h-[68px] items-center justify-between gap-4 max-[620px]:h-auto max-[620px]:flex-wrap max-[620px]:py-3"
      aria-label="Primary"
    >
      <a
        href="/"
        class="inline-flex items-center gap-3 font-display text-[1.1rem] font-semibold tracking-tight text-ondark"
        aria-label="The Pipeline, home"
      >
        <Mark size={34} />
        The Pipeline
      </a>

      <div class="flex items-center gap-1 max-[620px]:w-full max-[620px]:justify-start">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'relative px-3.5 py-2 text-[14px] transition-colors',
                isActive(item.href) ? 'text-ondark' : 'text-ondark-soft hover:text-ondark',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              {isActive(item.href) && (
                <span aria-hidden="true" class="absolute inset-x-3.5 bottom-0 h-0.5 rounded-full bg-gold" />
              )}
            </a>
          ))
        }
        <a
          href={navCta.href}
          class="lift-sm ml-2 inline-flex h-9 items-center rounded-pill bg-gold-bright px-5 text-[14px] font-semibold text-canopy transition-colors hover:bg-gold-pale"
          aria-current={isActive(navCta.href) ? 'page' : undefined}
        >
          {navCta.label}
        </a>
      </div>
    </nav>
  </div>
</header>
