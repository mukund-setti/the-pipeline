---
import Mark from './ui/Mark.astro';
import { nav, navCta } from '../data/site';

const path = (Astro.url.pathname.replace(/\/+$/, '') || '/');
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return path === h;
};
---
<header
  class="sticky top-0 z-50 border-b-2 border-line bg-bg/95 backdrop-blur supports-[backdrop-filter]:bg-bg/85"
>
  <div class="wrap">
    <nav
      class="flex h-16 items-center justify-between gap-4 max-[620px]:h-auto max-[620px]:flex-wrap max-[620px]:py-3"
      aria-label="Primary"
    >
      <a
        href="/"
        class="inline-flex items-center gap-2.5 font-display text-[1.05rem] font-semibold tracking-tight"
        aria-label="The Pipeline, home"
      >
        <Mark size={32} />
        The Pipeline
      </a>

      <div class="flex items-center gap-1 max-[620px]:w-full max-[620px]:justify-start">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'relative px-3.5 py-2 text-[14px] transition-colors',
                isActive(item.href) ? 'text-ink' : 'text-ink-soft hover:text-ink',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              {isActive(item.href) && (
                <span aria-hidden="true" class="absolute inset-x-3.5 -bottom-px h-0.5 bg-ink" />
              )}
            </a>
          ))
        }
        <a
          href={navCta.href}
          class="ml-2 inline-flex h-9 items-center border-2 border-transparent bg-brand px-4 text-[14px] font-medium text-white transition-colors hover:bg-brand-deep"
          aria-current={isActive(navCta.href) ? 'page' : undefined}
        >
          {navCta.label}
        </a>
      </div>
    </nav>
  </div>
</header>
