---
import Layout from '../components/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
---
<Layout
  title="404 · The Pipeline"
  description="That page isn't here, but the opportunities are."
  noindex
>
  <section class="grid place-items-start py-28 max-[560px]:py-20">
    <div class="wrap">
      <Eyebrow>Error 404</Eyebrow>
      <h1 class="mb-4 mt-4 max-w-[16ch] font-display text-pagehero font-semibold text-ink">
        This one got gatekept.
      </h1>
      <p class="mb-8 max-w-[48ch] text-lede text-ink-soft">
        That page isn't here, but the opportunities are.
      </p>
      <Button href="/" arrow>Back to home</Button>
    </div>
  </section>
</Layout>
