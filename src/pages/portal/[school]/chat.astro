---
/**
 * Chapter chat page: one static route per portal school, all rendering the
 * ChatApp island inside the shared shell. The active channel is picked by
 * the ?channel= query param at runtime (see ChatApp), so this single page
 * serves every room in the sidebar.
 */
import PortalShell from '../../../components/portal/PortalShell.astro';
import { PORTAL_SCHOOLS, schoolBySlug } from '../../../lib/schools';
import ChatApp from '../../../components/portal/ChatApp';

export function getStaticPaths() {
  return PORTAL_SCHOOLS.map((s) => ({ params: { school: s.slug } }));
}

const school = schoolBySlug(Astro.params.school as string)!;
---
<PortalShell school={school} active="chat" title="Chat">
  <ChatApp client:only="react" school={school.slug} />
</PortalShell>
