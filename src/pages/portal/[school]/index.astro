---
/**
 * Portal home: the chapter's landing pane. A static welcome band, quick links
 * into the three portal surfaces, and the standing weekly rhythm. The only
 * dynamic touch is the member's first name, filled in by a tiny script once
 * the shell's auth guard resolves, so this page needs no React island.
 */
import PortalShell from '../../../components/portal/PortalShell.astro';
import { PORTAL_SCHOOLS, schoolBySlug } from '../../../lib/schools';

export function getStaticPaths() {
  return PORTAL_SCHOOLS.map((s) => ({ params: { school: s.slug } }));
}

const school = schoolBySlug(Astro.params.school as string)!;
const base = `/portal/${school.slug}`;

const quickNav = [
  {
    href: `${base}/opportunities/`,
    icon: 'feed',
    title: 'Opportunities',
    body: 'The AI-tracked feed: internships, new grad roles, programs.',
  },
  {
    href: `${base}/forum/`,
    icon: 'forum',
    title: 'Forum',
    body: 'Writeups, questions, resume threads from every chapter.',
  },
  {
    href: `${base}/chat/`,
    icon: 'chat',
    title: 'Chat',
    body: 'The national room, your chapter room, and the prep channels.',
  },
] as const;

const week = [
  { icon: 'clock', label: 'Office hours over Discord and Meet', when: 'Thu · 6:00 PM' },
  { icon: 'doc', label: 'Resume review thread open in #resume-review', when: 'Open now' },
  { icon: 'people', label: 'Mock interview round-robin', when: 'Saturday' },
] as const;
---

<PortalShell school={school} active="home" title="Home">
  <div class="mx-auto w-full max-w-[1060px] px-5 py-8 md:px-8">
    {/* ── Welcome band ─────────────────────────────────────── */}
    <section
      class="rounded-panel border border-line bg-[linear-gradient(140deg,var(--school-soft),theme(colors.surface)_62%)] p-7 md:p-10"
    >
      <span class="label inline-flex items-center gap-2.5 text-[0.7rem] text-ink-soft">
        <span aria-hidden="true" class="h-1.5 w-1.5 flex-none rounded-full bg-gold-deep"></span>
        {school.name} chapter
      </span>
      <h2 class="mt-3 font-display text-h2 font-semibold tracking-tight text-ink">
        Welcome back<span data-welcome-name></span>.
      </h2>
      <p class="mt-3 max-w-[54ch] text-ink-soft">
        Your opportunity feed, the forum, and every chat room live here. Pick up where the
        community left off.
      </p>
    </section>

    {/* ── Quick nav ────────────────────────────────────────── */}
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        quickNav.map((item) => (
          <a
            href={item.href}
            class="portal-card group block p-6 transition-all duration-200 hover:-translate-y-1 hover:border-line-strong hover:shadow-lg"
          >
            <span class="flex h-9 w-9 items-center justify-center rounded-field bg-brand-soft text-brand">
              <svg
                class="h-[18px] w-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {item.icon === 'feed' && (
                  <>
                    <rect x="3" y="4" width="18" height="16" rx="3" />
                    <path d="M7 9h10M7 13h10M7 17h6" />
                  </>
                )}
                {item.icon === 'forum' && <path d="M21 12a8 8 0 0 1-8 8H4l2.5-2.7A8 8 0 1 1 21 12z" />}
                {item.icon === 'chat' && (
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                )}
              </svg>
            </span>
            <span class="mt-4 block font-display text-h3 font-semibold text-ink">{item.title}</span>
            <span class="mt-1.5 block text-[0.88rem] leading-relaxed text-ink-soft">{item.body}</span>
            <span class="mt-3 inline-flex items-center gap-1.5 text-[0.8rem] font-semibold text-ink">
              Open
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">
                &rarr;
              </span>
            </span>
          </a>
        ))
      }
    </div>

    {/* ── This week ────────────────────────────────────────── */}
    <section class="portal-card mt-6 p-6 md:p-7">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h3 class="font-display text-h3-lg font-semibold text-ink">This week in the pipeline</h3>
        <span class="portal-chip portal-chip--gold">Standing rhythm</span>
      </div>
      <ul class="mt-4 divide-y divide-line">
        {
          week.map((row) => (
            <li class="flex items-center gap-3.5 py-3.5">
              <span class="flex h-8 w-8 flex-none items-center justify-center rounded-field bg-[color:var(--school-soft)] text-[color:var(--school-deep)]">
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {row.icon === 'clock' && (
                    <>
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3 2" />
                    </>
                  )}
                  {row.icon === 'doc' && (
                    <>
                      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                      <path d="M14 3v5h5M9 13h6M9 17h4" />
                    </>
                  )}
                  {row.icon === 'people' && (
                    <>
                      <circle cx="9" cy="8" r="3.5" />
                      <path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                      <path d="M16 5.5a3.5 3.5 0 0 1 0 6M21 20c0-2.6-1.7-4.9-4-5.7" />
                    </>
                  )}
                </svg>
              </span>
              <span class="min-w-0 flex-1 text-[0.92rem] text-ink">{row.label}</span>
              <span class="label flex-none text-[0.64rem] text-ink-soft">{row.when}</span>
            </li>
          ))
        }
      </ul>
      <p class="border-t border-line pt-3.5 text-[0.8rem] text-ink-soft">
        The full schedule lives in the Discord; these are the standing ones.
      </p>
    </section>

    {/* ── Footer row ───────────────────────────────────────── */}
    <div
      class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-line pt-5 text-[0.82rem] text-ink-soft"
    >
      <span>The Pipeline member portal</span>
      <span class="ml-auto flex flex-wrap items-center gap-x-6 gap-y-2">
        <a class="font-semibold text-ink underline-offset-4 hover:underline" href="/">pipelineco.org</a>
        <a class="font-semibold text-ink underline-offset-4 hover:underline" href="/join/">Discord gate</a>
      </span>
    </div>
  </div>
</PortalShell>

<script>
  import { waitForPortalUser } from '../../../lib/portal/data';

  // Personalize the welcome line once the shell's guard resolves the member.
  waitForPortalUser().then((user) => {
    const slot = document.querySelector('[data-welcome-name]');
    if (slot) slot.textContent = ', ' + user.name.split(' ')[0];
  });
</script>
