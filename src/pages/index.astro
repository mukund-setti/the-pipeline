---
import Layout from '../components/Layout.astro';
import { site, nav, navCta, stages, stats, footer, placements } from '../data/site';

// Fonts come from Layout (Baloo 2 + Quicksand, self-hosted).

/** The fixed seed-to-plant scroll story (and the seed watermark that sets it
 *  up). Positioned in the gap between the content rail and the right vine. */
const SHOW_PLANT = true;

/* ── Edge vines, generated ──────────────────────────────────────────
   The trunks are cubic Bezier chains; sprig positions are EVALUATED on
   those curves (point + tangent) so every frond sits exactly on the
   vine and droops with its direction of growth. */
type V2 = [number, number];
type Seg = { c1: V2; c2: V2; to: V2 };
/** [segment index, t along it, droop side (+1/-1), scale] */
type Node = [number, number, 1 | -1, number];

const cubic = (p0: V2, s: Seg, t: number) => {
  const mt = 1 - t;
  const [x0, y0] = p0;
  const [x1, y1] = s.c1;
  const [x2, y2] = s.c2;
  const [x3, y3] = s.to;
  const x = mt ** 3 * x0 + 3 * mt * mt * t * x1 + 3 * mt * t * t * x2 + t ** 3 * x3;
  const y = mt ** 3 * y0 + 3 * mt * mt * t * y1 + 3 * mt * t * t * y2 + t ** 3 * y3;
  const dx = 3 * mt * mt * (x1 - x0) + 6 * mt * t * (x2 - x1) + 3 * t * t * (x3 - x2);
  const dy = 3 * mt * mt * (y1 - y0) + 6 * mt * t * (y2 - y1) + 3 * t * t * (y3 - y2);
  return { x, y, ang: (Math.atan2(dy, dx) * 180) / Math.PI };
};

const makeVine = (start: V2, segs: Seg[], nodes: Node[]) => {
  const d =
    `M${start[0]} ${start[1]} ` +
    segs.map((s) => `C${s.c1[0]} ${s.c1[1]} ${s.c2[0]} ${s.c2[1]} ${s.to[0]} ${s.to[1]}`).join(' ');
  const sprigs = nodes.map(([i, t, side, scale], idx) => {
    const p0 = i === 0 ? start : segs[i - 1].to;
    const p = cubic(p0, segs[i], t);
    // Droop ~50deg off the growth direction, with deterministic jitter.
    const rot = Math.round(p.ang + side * (50 + ((idx * 37) % 15) - 7));
    return {
      x: +p.x.toFixed(1),
      y: +p.y.toFixed(1),
      rot,
      scale,
      at: Math.min(0.97, +(p.y / 1000 + 0.045).toFixed(3)),
    };
  });
  return { d, sprigs };
};

const leftVine = makeVine(
  [34, 0],
  [
    { c1: [60, 70], c2: [16, 150], to: [40, 230] },
    { c1: [62, 300], c2: [18, 380], to: [42, 460] },
    { c1: [64, 530], c2: [22, 610], to: [46, 690] },
    { c1: [66, 760], c2: [28, 840], to: [50, 920] },
    { c1: [58, 955], c2: [48, 980], to: [52, 1000] },
  ],
  [
    [0, 0.15, 1, 0.9], [0, 0.45, -1, 0.85], [0, 0.8, 1, 1.0],
    [1, 0.2, -1, 0.9], [1, 0.55, 1, 1.1], [1, 0.85, -1, 0.8],
    [2, 0.25, 1, 0.95], [2, 0.6, -1, 1.05], [2, 0.9, 1, 0.85],
    [3, 0.3, -1, 1.0], [3, 0.65, 1, 0.9], [3, 0.92, -1, 0.85],
    [4, 0.25, 1, 0.9],
  ]
);

const rightVine = makeVine(
  [104, 0],
  [
    { c1: [80, 60], c2: [122, 140], to: [98, 220] },
    { c1: [78, 290], c2: [120, 370], to: [96, 450] },
    { c1: [76, 520], c2: [118, 600], to: [94, 680] },
    { c1: [76, 750], c2: [114, 830], to: [92, 910] },
    { c1: [84, 950], c2: [94, 980], to: [90, 1000] },
  ],
  [
    [0, 0.25, -1, 0.9], [0, 0.55, 1, 0.85], [0, 0.9, -1, 1.05],
    [1, 0.3, 1, 0.9], [1, 0.65, -1, 1.0],
    [2, 0.1, 1, 0.85], [2, 0.45, -1, 1.1], [2, 0.8, 1, 0.9],
    [3, 0.2, -1, 0.95], [3, 0.55, 1, 1.05], [3, 0.85, -1, 0.85],
    [4, 0.25, -1, 0.9],
  ]
);

/** Hero "job drops": chips fall in from the top like drops through a pipe. */
const drops = [
  { ...placements[3], x: 'left:7%', y: 'top:56%', d: '0.9s' },
  { ...placements[1], x: 'left:13%', y: 'top:74%', d: '1.08s' },
  { ...placements[0], x: 'right:22%', y: 'top:80%', d: '1.26s' },
  { ...placements[2], x: 'right:5%', y: 'top:70%', d: '1.44s' },
  { ...placements[4], x: 'right:13%', y: 'top:54%', d: '1.62s' },
];
---
<Layout
  title="The Pipeline · From campus to career"
  description={site.description}
  ogTitle="The Pipeline · From campus to career"
  ogDescription={site.ogDescription}
  bare
  themeColor="#53B72A"
>
  <div class="landing">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="sprout-mark" viewBox="0 0 120 130">
          <g fill="none" stroke="#A6E17A" stroke-width="7" stroke-linecap="round">
            <path d="M60 78 H106"/><path d="M60 78 V96 L46 112"/><path d="M60 96 L76 106"/><path d="M60 78 L38 90"/>
          </g>
          <g fill="#A6E17A">
            <circle cx="110" cy="78" r="5"/><circle cx="43" cy="115" r="5"/><circle cx="79" cy="108" r="5"/><circle cx="34" cy="92" r="5"/>
          </g>
          <path d="M60 40 V78" fill="none" stroke="#53B72A" stroke-width="11" stroke-linecap="round"/>
          <path d="M60 40 C57 24 48 10 30 5 C32 23 44 36 60 40 Z" fill="#4DAE2A"/>
          <path d="M62 46 C70 33 85 25 103 27 C96 42 80 50 62 46 Z" fill="#8FD460"/>
        </symbol>
        <symbol id="seed-mono" viewBox="0 0 120 130">
          <path d="M60 14 C88 26 100 58 84 92 C76 108 44 108 36 92 C20 58 32 26 60 14 Z" fill="#FFFFFF"/>
          <path d="M48 64 L58 54 L52 42" fill="none" stroke="#53B72A" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M60 106 V122" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/>
        </symbol>
        <symbol id="sprout-mono" viewBox="0 0 120 130">
          <g fill="none" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round">
            <path d="M60 78 H106"/><path d="M60 78 V96 L46 112"/><path d="M60 96 L76 106"/><path d="M60 78 L38 90"/>
          </g>
          <g fill="#FFFFFF">
            <circle cx="110" cy="78" r="5"/><circle cx="43" cy="115" r="5"/><circle cx="79" cy="108" r="5"/><circle cx="34" cy="92" r="5"/>
          </g>
          <path d="M60 40 V78" fill="none" stroke="#FFFFFF" stroke-width="11" stroke-linecap="round"/>
          <path d="M60 40 C57 24 48 10 30 5 C32 23 44 36 60 40 Z" fill="#FFFFFF"/>
          <path d="M62 46 C70 33 85 25 103 27 C96 42 80 50 62 46 Z" fill="#FFFFFF"/>
        </symbol>
        {/* One pinnate sprig: short stalk, two opposite leaflet pairs and a
            terminal leaflet, all real leaf-sized. Placed along the vines via
            <use> with rotate/scale from computed curve tangents. Points +x. */}
        <path id="leaflet" d="M0 0 C5 -6 13 -8 19 -4 C21 -2 21 -1 19 1 C13 4 5 3 0 0 Z"/>
        <g id="sprig">
          <path d="M0 0 C9 1 18 4 26 10" fill="none" stroke="#6BC241" stroke-width="2.5" stroke-linecap="round"/>
          <g transform="translate(8 1) rotate(-52) scale(0.75)"><use href="#leaflet" fill="#4DAE2A"/></g>
          <g transform="translate(8 1) rotate(58) scale(0.7)"><use href="#leaflet" fill="#8FD460"/></g>
          <g transform="translate(17 4) rotate(-38) scale(0.9)"><use href="#leaflet" fill="#8FD460"/></g>
          <g transform="translate(17 4) rotate(46) scale(0.85)"><use href="#leaflet" fill="#4DAE2A"/></g>
          <g transform="translate(26 10) rotate(10)"><use href="#leaflet" fill="#8FD460"/></g>
        </g>
        {/* Five-petal white blossom for the tree finale. Centered on origin. */}
        <g id="blossom">
          <g fill="#FFFFFF" stroke="#DCEBCB" stroke-width="0.8">
            <ellipse cx="0" cy="-5.2" rx="3" ry="5.2"/>
            <ellipse cx="0" cy="-5.2" rx="3" ry="5.2" transform="rotate(72)"/>
            <ellipse cx="0" cy="-5.2" rx="3" ry="5.2" transform="rotate(144)"/>
            <ellipse cx="0" cy="-5.2" rx="3" ry="5.2" transform="rotate(216)"/>
            <ellipse cx="0" cy="-5.2" rx="3" ry="5.2" transform="rotate(288)"/>
          </g>
          <circle r="2.4" fill="#CDF0A9"/>
        </g>
      </defs>
    </svg>

    <nav class="pill-nav" aria-label="Main">
      <a class="nav-brand" href="/">
        <svg aria-hidden="true"><use href="#sprout-mark"/></svg>
        The Pipeline
      </a>
      <div class="nav-links">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <a class="nav-join" href={navCta.href}>{navCta.label}</a>
    </nav>

    <section class="hero">
      {/* With the plant story on, the watermark is the seed it grows from. */}
      <svg class="watermark" aria-hidden="true"><use href={SHOW_PLANT ? '#seed-mono' : '#sprout-mono'}/></svg>
      <div class="seed-dot s1" aria-hidden="true"></div>
      <div class="seed-dot s2" aria-hidden="true"></div>
      <div class="seed-dot s3" aria-hidden="true"></div>
      <div class="seed-dot s4" aria-hidden="true"></div>

      {/* Gatekept job drops, literally dropping in. Real placements. */}
      <ul class="drops" aria-label="Where fellows have landed">
        {
          drops.map((p) => (
            <li class="drop" style={`${p.x};${p.y};--d:${p.d}`}>
              {p.logo && <img src={p.logo} alt="" loading="eager" decoding="async" />}
              <span>{p.org}</span>
            </li>
          ))
        }
      </ul>

      <h1>Pipeline</h1>
      <svg class="underline" viewBox="0 0 380 24" fill="none" aria-hidden="true">
        <path
          d="M6 14 C 90 4, 190 22, 290 10 S 360 12, 374 10"
          stroke="#A6E17A"
          stroke-width="8"
          stroke-linecap="round"
        />
      </svg>
      <p class="tagline">
        A fellow-run community moving underrepresented undergrads in tech from campus into the
        rooms they were kept out of.
      </p>
      <div class="cta-row">
        <a class="btn btn-join" href="/join/">Join the Pipeline</a>
        <a class="btn btn-learn" href="#how">Learn more</a>
      </div>
    </section>

    {/* Scroll zone: roots grow down both edges as you move through it. */}
    <div class="grow" id="grow">
      <svg class="roots roots-left" viewBox="0 0 140 1000" preserveAspectRatio="none" aria-hidden="true">
        <path class="trace-draw trunk" pathLength="1" data-start="0" data-end="1" d={leftVine.d}/>
        {
          leftVine.sprigs.map((s) => (
            <g class="leaf pop-grow" data-at={s.at} style={`transform-origin:${s.x}px ${s.y}px`}>
              <g transform={`translate(${s.x} ${s.y}) rotate(${s.rot}) scale(${s.scale})`}>
                <use href="#sprig"/>
              </g>
            </g>
          ))
        }
      </svg>
      <svg class="roots roots-right" viewBox="0 0 140 1000" preserveAspectRatio="none" aria-hidden="true">
        <path class="trace-draw trunk" pathLength="1" data-start="0" data-end="1" d={rightVine.d}/>
        {
          rightVine.sprigs.map((s) => (
            <g class="leaf pop-grow" data-at={s.at} style={`transform-origin:${s.x}px ${s.y}px`}>
              <g transform={`translate(${s.x} ${s.y}) rotate(${s.rot}) scale(${s.scale})`}>
                <use href="#sprig"/>
              </g>
            </g>
          ))
        }
      </svg>

      <section id="how" class="how">
        <h2>Three stages, one direction: forward.</h2>
        <div class="cards">
          {
            stages.map((s) => (
              <article class="card">
                <span class="stage-label">{s.num} · {s.label}</span>
                <h3>{s.title}</h3>
                <p>{s.short}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="stats" aria-label="The Pipeline in numbers">
        {
          stats.map((s) => (
            <div class="stat">
              <span class="num">{s.num}</span>
              <span class="cap">{s.cap}</span>
            </div>
          ))
        }
      </section>

      <section class="cta">
        <div class="cta-panel">
          <h2>Get in the pipeline.</h2>
          <p>It's free, it's run by fellows, and it works.</p>
          <a class="btn btn-join" href="/join/">Join the Pipeline</a>
        </div>
        <p class="footer-line">{footer.builtBy} · {footer.copyright}</p>
      </section>
    </div>

    {/* Seed-to-tree scroll story: a centered background tree behind the
        content. Roots erupt from the seed, the trunk rises, the canopy
        fills in, then white blossoms open at the end of the page. */}
    {SHOW_PLANT && (
    <div class="plant" id="plant" aria-hidden="true">
      <svg viewBox="0 0 600 640">
        <g class="seed-shrink" data-at="0.14">
          <ellipse cx="300" cy="566" rx="17" ry="21" fill="#1C4A12"/>
          <path d="M292 562 L302 553 L296 544" fill="none" stroke="#A6E17A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
        {/* Roots erupt first */}
        <path class="trace-draw twig" pathLength="1" data-start="0.04" data-end="0.14"
          d="M300 568 C260 572 222 568 182 580 C152 589 132 602 120 618"/>
        <path class="trace-draw twig" pathLength="1" data-start="0.05" data-end="0.15"
          d="M300 568 C340 574 380 572 416 584 C446 594 464 606 474 622"/>
        <path class="trace-draw twig" pathLength="1" data-start="0.07" data-end="0.16"
          d="M296 572 C270 586 250 602 240 624"/>
        <path class="trace-draw twig" pathLength="1" data-start="0.08" data-end="0.17"
          d="M304 572 C330 588 348 606 354 628"/>
        {/* Trunk and boughs */}
        <path class="trace-draw stem" pathLength="1" data-start="0.12" data-end="0.34"
          d="M300 570 C292 520 308 465 298 405 C290 350 304 300 296 245"/>
        <path class="trace-draw twig" pathLength="1" data-start="0.30" data-end="0.42" d="M298 405 C250 380 205 368 160 370"/>
        <path class="trace-draw twig" pathLength="1" data-start="0.36" data-end="0.48" d="M299 360 C350 335 395 325 440 330"/>
        <path class="trace-draw twig" pathLength="1" data-start="0.42" data-end="0.52" d="M297 305 C258 282 222 270 190 268"/>
        <path class="trace-draw twig" pathLength="1" data-start="0.48" data-end="0.58" d="M297 280 C332 258 366 246 398 246"/>
        <path class="trace-draw twig" pathLength="1" data-start="0.52" data-end="0.60" d="M296 245 C292 215 300 190 296 165"/>
        {/* Bough tufts */}
        <circle class="pop-grow" data-at="0.44" style="transform-origin:160px 370px" cx="160" cy="370" r="42" fill="#4DAE2A"/>
        <circle class="pop-grow" data-at="0.46" style="transform-origin:128px 340px" cx="128" cy="340" r="32" fill="#8FD460"/>
        <circle class="pop-grow" data-at="0.50" style="transform-origin:440px 330px" cx="440" cy="330" r="44" fill="#4DAE2A"/>
        <circle class="pop-grow" data-at="0.52" style="transform-origin:470px 300px" cx="470" cy="300" r="30" fill="#66C63C"/>
        <circle class="pop-grow" data-at="0.56" style="transform-origin:190px 268px" cx="190" cy="268" r="36" fill="#66C63C"/>
        <circle class="pop-grow" data-at="0.62" style="transform-origin:398px 246px" cx="398" cy="246" r="40" fill="#4DAE2A"/>
        {/* Crown */}
        <circle class="pop-grow" data-at="0.66" style="transform-origin:296px 150px" cx="296" cy="150" r="70" fill="#4DAE2A"/>
        <circle class="pop-grow" data-at="0.68" style="transform-origin:215px 185px" cx="215" cy="185" r="56" fill="#66C63C"/>
        <circle class="pop-grow" data-at="0.70" style="transform-origin:378px 180px" cx="378" cy="180" r="58" fill="#4DAE2A"/>
        <circle class="pop-grow" data-at="0.72" style="transform-origin:296px 215px" cx="296" cy="215" r="64" fill="#8FD460"/>
        <circle class="pop-grow" data-at="0.74" style="transform-origin:160px 230px" cx="160" cy="230" r="44" fill="#8FD460"/>
        <circle class="pop-grow" data-at="0.76" style="transform-origin:430px 225px" cx="430" cy="225" r="46" fill="#8FD460"/>
        <circle class="pop-grow" data-at="0.78" style="transform-origin:245px 110px" cx="245" cy="110" r="44" fill="#66C63C"/>
        <circle class="pop-grow" data-at="0.78" style="transform-origin:350px 115px" cx="350" cy="115" r="40" fill="#8FD460"/>
        {/* Blossoms */}
        <g class="pop-grow" data-at="0.82" style="transform-origin:240px 150px">
          <g transform="translate(240 150) rotate(12) scale(2)"><use href="#blossom"/></g>
        </g>
        <g class="pop-grow" data-at="0.84" style="transform-origin:350px 140px">
          <g transform="translate(350 140) rotate(40) scale(1.7)"><use href="#blossom"/></g>
        </g>
        <g class="pop-grow" data-at="0.86" style="transform-origin:200px 220px">
          <g transform="translate(200 220) rotate(65) scale(1.9)"><use href="#blossom"/></g>
        </g>
        <g class="pop-grow" data-at="0.88" style="transform-origin:395px 205px">
          <g transform="translate(395 205) rotate(25) scale(2.1)"><use href="#blossom"/></g>
        </g>
        <g class="pop-grow" data-at="0.90" style="transform-origin:298px 190px">
          <g transform="translate(298 190) rotate(50) scale(1.7)"><use href="#blossom"/></g>
        </g>
        <g class="pop-grow" data-at="0.92" style="transform-origin:160px 350px">
          <g transform="translate(160 350) rotate(18) scale(1.8)"><use href="#blossom"/></g>
        </g>
        <g class="pop-grow" data-at="0.94" style="transform-origin:445px 315px">
          <g transform="translate(445 315) rotate(72) scale(1.7)"><use href="#blossom"/></g>
        </g>
        <g class="pop-grow" data-at="0.96" style="transform-origin:195px 255px">
          <g transform="translate(195 255) rotate(35) scale(1.9)"><use href="#blossom"/></g>
        </g>
        <g class="pop-grow" data-at="0.98" style="transform-origin:296px 90px">
          <g transform="translate(296 90) rotate(8) scale(2.2)"><use href="#blossom"/></g>
        </g>
      </svg>
    </div>
    )}
  </div>
</Layout>

<script>
  const grow = document.getElementById('grow');
  const plant = document.getElementById('plant');
  const traces = Array.from(document.querySelectorAll<SVGPathElement>('.trace-draw'));
  const pops = Array.from(document.querySelectorAll<HTMLElement>('[data-at]'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced || !grow) {
    for (const t of traces) t.style.strokeDashoffset = '0';
    for (const p of pops) p.classList.add('on');
  } else {
    let ticking = false;
    const render = () => {
      ticking = false;
      const rect = grow.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / rect.height));
      for (const t of traces) {
        const start = Number(t.dataset.start ?? 0);
        const end = Number(t.dataset.end ?? 1);
        const local = Math.min(1, Math.max(0, (progress - start) / (end - start)));
        t.style.strokeDashoffset = String(1 - local);
      }
      for (const p of pops) p.classList.toggle('on', progress >= Number(p.dataset.at ?? 0));
      plant?.classList.toggle('visible', progress > 0.02);
    };
    const queue = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    render();
  }
</script>

<style>
  .landing {
    --sprout: #53b72a;
    --sprout-deep: #3e9b1f;
    --lime: #a6e17a;
    --fern: #1c4a12;
    --cream: #fbfff4;
    --radius-pill: 999px;

    position: relative;
    font-family: 'Quicksand', ui-sans-serif, system-ui, sans-serif;
    color: #fff;
  }

  /* ---------- white pill nav ---------- */
  .pill-nav {
    position: fixed;
    top: 22px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--cream);
    border-radius: var(--radius-pill);
    padding: 8px 10px 8px 16px;
    box-shadow: 0 10px 30px rgba(28, 74, 18, 0.28);
    max-width: calc(100vw - 32px);
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Baloo 2', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 17px;
    color: var(--sprout-deep);
    text-decoration: none;
    margin-right: 8px;
    white-space: nowrap;
  }
  .nav-brand svg { width: 24px; height: 26px; }
  .nav-links { display: flex; gap: 2px; }
  .nav-links a {
    text-decoration: none;
    color: var(--fern);
    font-weight: 700;
    font-size: 14.5px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    transition: background 0.18s ease;
  }
  .nav-links a:hover { background: rgba(166, 225, 122, 0.4); }
  .nav-links a:focus-visible,
  .nav-brand:focus-visible,
  .btn:focus-visible,
  .nav-join:focus-visible {
    outline: 3px solid var(--fern);
    outline-offset: 2px;
  }
  .nav-join {
    font-weight: 700;
    font-size: 14.5px;
    color: var(--fern);
    background: var(--lime);
    border-radius: var(--radius-pill);
    padding: 9px 18px;
    text-decoration: none;
    margin-left: 4px;
    transition: background 0.18s ease;
  }
  .nav-join:hover { background: var(--sprout); color: #fff; }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
