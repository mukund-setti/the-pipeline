---
import Layout from '../components/Layout.astro';
import { site, hero, stats, drops, dropsTotalCount, events, sponsorSlotCount, links } from '../data/site';

// Homepage stat strip: 4 real cells, not the reference's placeholder numbers.
const heroStats = stats.slice(0, 4);
---
<Layout
  title="The Pipeline · A fellow-run community across the UC system"
  description={site.description}
  ogTitle="The Pipeline · Across the UC system"
  ogDescription={site.ogDescription}
>
  {/* ── Hero ─────────────────────────────────────────────── */}
  <section class="on-ink bg-board-bg pb-16 pt-12 text-board-text md:pb-20 md:pt-16">
    <div class="wrap grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
      <div>
        <div class="mb-6 inline-flex items-center gap-2 font-boardMono text-[11px] uppercase tracking-[0.14em] text-board-green">
          <span class="h-1.5 w-1.5 flex-none rounded-full bg-board-green" aria-hidden="true"></span>
          {hero.eyebrow}
        </div>
        <h1 class="mb-[22px] max-w-[17ch] font-boardDisplay text-[clamp(2.2rem,5.5vw,3.9rem)] font-extrabold leading-[1.04] tracking-[-0.02em] text-board-text">
          Internships are won<br class="hidden sm:block" />
          before the application<br class="hidden sm:block" />
          opens.
        </h1>
        <p class="mb-8 max-w-[54ch] font-boardSans text-[17px] leading-relaxed text-board-textMuted">
          Pipeline is UCI's CS recruitment club. We run the referral network, the resume desk,
          and the mock interview loop that get members into tech — and we keep the board of
          who's hiring, updated daily.
        </p>
        <div class="mb-10 flex flex-wrap items-center gap-3">
          <a
            href="/join/"
            class="inline-flex items-center gap-2 bg-board-green px-7 py-[15px] font-boardSans text-[15px] font-semibold text-board-greenInk transition-colors hover:bg-board-text"
          >
            Join Pipeline
          </a>
          <a
            href="#this-week"
            class="inline-flex items-center border border-board-lineButton px-7 py-[15px] font-boardSans text-[15px] font-medium text-board-text transition-colors hover:border-board-text"
          >
            See this week's events
          </a>
        </div>
        <div class="grid grid-cols-2 gap-px border border-board-line bg-board-line sm:grid-cols-4">
          {
            heroStats.map((s) => (
              <div class="bg-board-bg px-3.5 py-4">
                <div class="font-boardDisplay text-[28px] font-bold text-board-text">{s.num}</div>
                <div class="mt-1 font-boardMono text-[10px] uppercase tracking-[0.1em] text-board-textDim">
                  {s.cap}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {/* Open drops panel: sample data, honestly labeled — see src/data/site.ts. */}
      <div class="border border-board-line bg-board-surface">
        <div class="flex items-center justify-between border-b border-board-line px-[18px] py-[14px] font-boardMono text-[11px] uppercase tracking-[0.12em]">
          <span class="text-board-text">Open drops</span>
          <span class="text-board-textDim">Sample data</span>
        </div>
        <div>
          {
            drops.map((d) => (
              <div class="grid grid-cols-[1fr_auto] gap-3 border-b border-board-lineSubtle px-[18px] py-4">
                <div>
                  <div class="font-boardSans text-[15px] font-semibold text-board-text">{d.role}</div>
                  <div class="mt-1 font-boardMono text-[11px] text-board-textDim">
                    {d.company} · {d.qualifier}
                  </div>
                </div>
                <div class="whitespace-nowrap font-boardMono text-[11px] text-board-green">{d.closesAt}</div>
              </div>
            ))
          }
          <a
            href="/join/"
            class="block px-[18px] py-[15px] font-boardMono text-[11px] uppercase tracking-[0.12em] text-board-green transition-colors hover:text-board-text"
          >
            Members see all {dropsTotalCount} &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── This week ────────────────────────────────────────── */}
  <section id="this-week" class="on-ink border-t border-board-line bg-board-bg py-16 text-board-text md:py-20">
    <div class="wrap">
      <div class="mb-2 border-b border-board-line pb-[18px]">
        <h2 class="font-boardDisplay text-[26px] font-bold tracking-[-0.01em] text-board-text">This week</h2>
      </div>
      <div>
        {
          events.map((e) => (
            <div class="flex flex-col gap-2 border-b border-board-lineSubtle py-5 sm:grid sm:grid-cols-[96px_1fr_200px_130px] sm:items-center sm:gap-5">
              <div class="font-boardMono text-[12px] text-board-green">{e.date}</div>
              <div>
                <div class="font-boardSans text-[17px] font-semibold text-board-text">{e.title}</div>
                <div class="mt-1 font-boardSans text-[13px] text-board-textDim">{e.description}</div>
              </div>
              <div class="font-boardMono text-[12px] text-board-textMuted">
                {e.time} · {e.location}
              </div>
              <a
                href={links.form}
                target="_blank"
                rel="noopener"
                class:list={[
                  'inline-flex items-center justify-center px-5 py-[9px] font-boardSans text-[13px] transition-colors sm:justify-self-end',
                  e.featured
                    ? 'bg-board-green font-semibold text-board-greenInk hover:bg-board-text'
                    : 'border border-board-lineButton font-medium text-board-text hover:border-board-text',
                ]}
              >
                RSVP
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Sponsors ─────────────────────────────────────────── */}
  <section class="on-ink border-t border-board-line bg-board-bg py-10 text-board-text">
    <div class="wrap">
      <div class="mb-[18px] font-boardMono text-[11px] uppercase tracking-[0.12em] text-board-textDim">
        Backed by
      </div>
      <div class="flex flex-wrap gap-3.5">
        {
          Array.from({ length: sponsorSlotCount }).map(() => (
            <div class="board-sponsor-slot h-[52px] min-w-[120px] flex-1 font-boardMono text-[10px] uppercase tracking-[0.1em] text-board-textMuted" />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
